---
// Renders exactly the four `status` enum values from src/content.config.ts.
// No trailing suffixes ("V1.0", "ALPHA") — those aren't schema fields.

interface Props {
  status: 'shipped' | 'in-progress' | 'concept' | 'archived';
}

const { status } = Astro.props;

const LABELS: Record<Props['status'], string> = {
  shipped: 'SHIPPED',
  'in-progress': 'IN PROGRESS',
  concept: 'CONCEPT',
  archived: 'ARCHIVED',
};

const DOT_CLASS: Record<Props['status'], string> = {
  shipped: 'bg-accent-b',
  'in-progress': 'bg-signal',
  concept: 'bg-ink-muted',
  archived: '',
};

const isArchived = status === 'archived';
---

<div
  class:list={[
    'inline-flex items-center gap-3 border border-hairline bg-surface-raised px-4 py-2',
    isArchived && 'opacity-60',
  ]}
>
  {
    isArchived ? (
      <span class="h-2 w-2 rounded-full border border-hairline" />
    ) : (
      <span class={`h-2 w-2 animate-pulse rounded-full ${DOT_CLASS[status]}`} />
    )
  }
  <span class:list={['font-mono text-mono uppercase', isArchived ? 'text-ink-muted' : 'text-ink']}>
    {LABELS[status]}
  </span>
</div>
