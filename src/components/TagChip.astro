---
// A filter/category chip. `active` sets the initial server-rendered state
// (index.astro marks "All" active); after hydration, gallery.ts owns the
// live state by toggling `aria-pressed` on click, and the selected-state
// styling below keys off that attribute rather than a class, so JS only
// ever needs to flip one attribute per chip.
//
// `interactive` defaults to true for that filter-chip use case. Set it to
// false for a purely decorative tag with no click/filter behavior (e.g.
// the About page's capability/focus tags) -- renders a <span> instead of
// a <button>, with no aria-pressed/data-filter/hover-as-button affordance,
// since there's nothing here for a screen reader or keyboard user to
// interact with.

interface Props {
  label: string;
  active?: boolean;
  interactive?: boolean;
}

const { label, active = false, interactive = true } = Astro.props;
const Tag = interactive ? 'button' : 'span';
---

<Tag
  type={interactive ? 'button' : undefined}
  data-filter={interactive ? label : undefined}
  aria-pressed={interactive ? active : undefined}
  class:list={[
    'chip whitespace-nowrap border border-hairline px-4 py-2 font-mono text-mono uppercase tracking-widest text-ink-muted',
    interactive && 'focus-ring transition-colors hover:border-hairline-bright hover:text-ink',
  ]}
>
  {label}
</Tag>

<style>
  /* Selected state: accent-a (#7C5CFF), per the design tokens' "structural
     only" rule — this is a solid background with dark text on top, not
     accent-a used as text-on-void, so it doesn't run into the WCAG AA
     failure that rule exists to prevent (see tokens.css).

     Text colour is literal black, not var(--color-bg-void): measured
     contrast of accent-a against bg-void (#0B0D0F) is 4.479:1, which
     fails the 4.5:1 AA threshold by a hair (caught by Lighthouse, not by
     eye). Literal black against accent-a measures 4.832:1 and passes.
     This changes only this one text-on-accent-a case, not the bg-void
     token itself or accent-a's value. */
  .chip[aria-pressed='true'] {
    border-color: var(--color-accent-a);
    background-color: var(--color-accent-a);
    color: #000;
  }
  .chip[aria-pressed='true']:hover {
    border-color: var(--color-accent-a);
    color: #000;
  }
</style>
