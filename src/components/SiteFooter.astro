---
import siteConfig from '../../site.config';
import { externalLinkAttrs } from '../utils/links';

const currentYear = new Date().getFullYear();
const copyrightYears =
  siteConfig.foundedYear === currentYear
    ? `${currentYear}`
    : `${siteConfig.foundedYear}–${currentYear}`;
---

<footer class="w-full border-t border-hairline bg-surface py-12">
  <div class="mx-auto flex max-w-max-width flex-col items-center justify-between gap-8 px-margin-mobile md:flex-row md:px-margin-desktop">
    <div class="flex flex-col items-center gap-4 md:items-start">
      <div class="font-display text-h3 font-bold uppercase tracking-tighter text-ink">
        {siteConfig.name}
      </div>
      <div class="flex gap-4 font-mono text-mono uppercase">
        {
          siteConfig.social.map((link) => (
            <a
              href={link.url}
              {...externalLinkAttrs(link.url)}
              class="focus-ring text-ink-muted transition-colors hover:text-ink"
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
    <!-- No opacity-60 here: it was dimming ink-muted (5.715:1 on surface)
         down to 2.881:1, failing WCAG AA (measured via Lighthouse, not
         visible by eye against this dark background). ink-muted at full
         opacity already reads as the least-prominent text on the page —
         the extra dimming wasn't adding a visual distinction worth losing
         AA compliance for. -->
    <div class="font-mono text-mono uppercase text-ink-muted">
      &copy; {copyrightYears} {siteConfig.copyrightHolder}
    </div>
  </div>
</footer>
