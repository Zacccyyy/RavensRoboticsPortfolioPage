---
// Asymmetric bento grid. Span is driven entirely by each entry's `cardSize`
// — no per-project overrides — so a fork with a different project mix still
// tiles sensibly instead of collapsing into a uniform grid.
//
// Deliberately NOT `grid-auto-flow: dense`: dense packing can reorder cards
// visually away from DOM order, which desyncs keyboard tab order from what's
// on screen. With this project's actual span mix (two 2x2s, two 1x2s, one
// 1x1) sparse flow already tiles with no internal gaps — only the expected
// trailing partial row when the count doesn't divide evenly into 3 columns.
// If a future content mix does leave an avoidable gap, `dense` is a one-line
// opt-in trade (visual polish for tab-order fidelity) rather than a default.

import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;

const SPAN: Record<CollectionEntry<'projects'>['data']['cardSize'], string> = {
  lg: 'md:col-span-2 md:row-span-2',
  md: 'md:col-span-1 md:row-span-2',
  sm: 'md:col-span-1 md:row-span-1',
};

// Featured projects get a second presentation on mobile: a horizontal
// scroll-snap rail (one full card + a peek of the next) above the plain
// stacked list. This is the SAME set of DOM nodes as the desktop bento
// grid, not a duplicate render — each ProjectCard would otherwise carry a
// `transition:name` and preload="none" video that appear exactly once in
// the document, and a second copy of either breaks (duplicate
// view-transition-name aborts the morph; a second <video> would double the
// real network request once hovered/played).
//
// The trick: `.featured-rail` is `flex overflow-x-auto` on mobile and
// `display: contents` from md: up — at that breakpoint it generates no box
// of its own, so its ProjectCard children fall straight into the outer
// grid as ordinary grid items, in the same DOM position (first, since
// `featured` sorts first) they'd occupy if this wrapper didn't exist at
// all. Desktop layout is therefore byte-for-byte what it was before this
// wrapper was added.
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<div id="project-grid" class="flex flex-col gap-6 md:grid md:grid-cols-3 md:gap-gutter md:auto-rows-[280px]">
  {
    featured.length > 0 && (
      <div class="featured-rail -mx-margin-mobile flex snap-x snap-mandatory gap-4 overflow-x-auto px-margin-mobile pb-2 md:contents md:mx-0 md:gap-0 md:overflow-visible md:px-0 md:pb-0">
        {featured.map((project) => {
          const index = projects.indexOf(project);
          return (
            <div class="rail-item h-[400px] w-[85%] shrink-0 snap-start md:contents md:h-auto md:w-auto">
              <ProjectCard project={project} eager={index < 2} index={index} class={SPAN[project.data.cardSize]} />
            </div>
          );
        })}
      </div>
    )
  }
  {
    rest.map((project) => {
      const index = projects.indexOf(project);
      return <ProjectCard project={project} eager={index < 2} index={index} class={SPAN[project.data.cardSize]} />;
    })
  }
</div>
