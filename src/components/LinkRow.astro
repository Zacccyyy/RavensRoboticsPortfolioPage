---
// Renders whichever of links.{github,demo,docs} and downloads exist — never
// an empty or dead button. Downloads is a real disclosure (WAI-ARIA APG
// "Disclosure" pattern): aria-expanded on the trigger, Escape closes it,
// clicking outside closes it, and focus returns to the trigger either way.
// The old mockup version only opened on CSS :hover, so it had none of that.
import type { CollectionEntry } from 'astro:content';
import { externalLinkAttrs } from '../utils/links';

interface Props {
  links?: CollectionEntry<'projects'>['data']['links'];
  downloads?: CollectionEntry<'projects'>['data']['downloads'];
}

const { links, downloads } = Astro.props;
const hasDownloads = Boolean(downloads?.length);
---

{
  (links?.github || links?.demo || links?.docs || hasDownloads) && (
    <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap">
      {links?.github && (
        <a
          href={links.github}
          {...externalLinkAttrs(links.github)}
          class="focus-ring flex w-full items-center justify-center gap-3 border border-ink px-8 py-4 font-mono text-mono uppercase text-ink transition-colors hover:bg-ink hover:text-bg-void sm:w-auto"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M8 4 3 12l5 8M16 4l5 8-5 8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          View Source
        </a>
      )}
      {links?.demo && (
        <a
          href={links.demo}
          {...externalLinkAttrs(links.demo)}
          class="focus-ring flex w-full items-center justify-center gap-3 bg-signal px-8 py-4 font-mono text-mono font-bold uppercase text-bg-void transition-[filter] hover:brightness-110 sm:w-auto"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M13 3 4 14h7l-1 7 9-11h-7l1-7Z" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Live Demo
        </a>
      )}
      {links?.docs && (
        <a
          href={links.docs}
          {...externalLinkAttrs(links.docs)}
          class="focus-ring flex w-full items-center justify-center gap-3 border border-ink px-8 py-4 font-mono text-mono uppercase text-ink transition-colors hover:bg-ink hover:text-bg-void sm:w-auto"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M6 3h9l5 5v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M14 3v6h6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          Docs
        </a>
      )}

      {hasDownloads && (
        <div class="relative w-full sm:w-auto" data-downloads>
          <button
            type="button"
            data-downloads-trigger
            aria-expanded="true"
            aria-controls="downloads-panel"
            class="focus-ring flex w-full items-center justify-center gap-3 border border-transparent px-8 py-4 font-mono text-mono uppercase text-accent-b transition-colors hover:border-accent-b sm:w-auto"
          >
            Downloads
            <svg
              data-downloads-chevron
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              class="transition-transform"
            >
              <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div
            id="downloads-panel"
            data-downloads-panel
            class="absolute left-0 top-full z-20 mt-2 w-80 space-y-4 border border-hairline bg-surface-raised p-6 font-mono text-mono-xs"
          >
            {downloads?.map((file, index) => (
              <a
                href={file.url}
                download
                {...externalLinkAttrs(file.url)}
                class:list={[
                  'focus-ring flex items-center justify-between gap-4 pb-2 text-ink-muted transition-colors hover:text-ink',
                  index < (downloads?.length ?? 0) - 1 && 'border-b border-hairline',
                ]}
              >
                <span class="uppercase text-ink">{file.label}</span>
                <span>{file.size}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  )
}

<script src="/scripts/downloads-disclosure.js" is:inline></script>
