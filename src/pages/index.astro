---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CardGrid from '../components/CardGrid.astro';
import TagChip from '../components/TagChip.astro';
import SystemReadout from '../components/SystemReadout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CATEGORIES } from '../content.config';
import siteConfig from '../../site.config';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf(),
);

// Person: this repo's whole point is showcasing one person's builds, so the
// homepage carries the full profile — project pages reference the same
// person only briefly, as CreativeWork.creator (see [slug].astro).
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  description: siteConfig.bio,
  url: siteConfig.seo.siteUrl,
  email: siteConfig.email,
  sameAs: siteConfig.social.map((link) => link.url),
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  description: siteConfig.seo.description,
  url: siteConfig.seo.siteUrl,
};
---

<BaseLayout
  title={siteConfig.seo.title}
  description={siteConfig.seo.description}
  structuredData={[personSchema, websiteSchema]}
>
  <SiteHeader />

  <main class="pb-24 pt-32">
    <!-- Hero -->
    <section class="relative mx-auto mb-16 max-w-max-width px-margin-mobile md:px-margin-desktop">
      <div class="max-w-4xl">
        <h1 class="mb-8 font-display text-display-lg uppercase text-ink md:text-display-xl">
          {siteConfig.tagline}
        </h1>
        <p class="max-w-xl font-body text-body-lg text-ink-muted">
          {siteConfig.bio}
        </p>
      </div>
      <SystemReadout />
    </section>

    <!-- Filters -->
    <section class="mx-auto mb-12 max-w-max-width px-margin-mobile md:px-margin-desktop">
      <h2 class="sr-only">Filter by category</h2>
      <div class="flex flex-wrap gap-3">
        <TagChip label="All" active />
        {CATEGORIES.map((category) => <TagChip label={category} />)}
      </div>
    </section>

    <!-- Grid -->
    <section id="work" class="mx-auto max-w-max-width scroll-mt-24 px-margin-mobile md:px-margin-desktop">
      <h2 class="sr-only">Selected work</h2>
      <CardGrid projects={projects} />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  // Gallery-only interaction layer (tilt, border sweep trigger, hover video
  // preview, filter chips, scroll reveal fallback) — see src/scripts/gallery.ts.
  // Astro bundles this per-page, so project detail pages never ship it.
  import '../scripts/gallery.ts';
</script>
